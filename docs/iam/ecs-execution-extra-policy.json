{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAppSecrets",
      "Effect": "Allow",
      "Action": "ssm:GetParameters",
      "Resource": "arn:aws:ssm:ap-south-1:<ACCOUNT_ID>:parameter/devops-project-1/*"
    },
    {
      "Sid": "CreateLogGroup",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:ap-south-1:<ACCOUNT_ID>:log-group:/ecs/devops-project-1*"
    }
  ]
}
